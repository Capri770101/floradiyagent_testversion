# ============================================================
# 生产环境后端配置模板（复制为 misc/.env，填入真实值；.env 已被 .gitignore 忽略）
# 变量名即 backend/config.py 的字段名（pydantic-settings 大小写不敏感）。
# ============================================================

# ---- 数据库：PostgreSQL（自托管于 ECS 内，docker-compose 已用 environment 覆盖为
#      postgresql+asyncpg://flora:flora_dev_pass@postgres:5432/flora，此处留空即可；
#      若改用阿里云 RDS，则填 RDS 内网地址并删掉 compose 里的 postgres 服务）----
DATABASE_URL=

# ---- Redis：容器编排内用服务名；跨主机填内网地址 ----
# 容器内：redis://redis:6379/0 ；直连 ECS 本机：redis://127.0.0.1:6379/0
REDIS_URL=redis://redis:6379/0

# ---- 开启异步任务队列（图片生成交给 worker 容器）----
TASK_QUEUE_ENABLED=true

# ---- 运行环境 ----
APP_ENV=prod

# ---- CORS 跨域白名单（三端独立域名架构）----
CORS_ORIGINS=["https://c.tiaowulan.com","https://admin.tiaowulan.com","https://merchant.tiaowulan.com"]

# ---- JWT 与鉴权：生产必须 AUTH_REQUIRED=true，并设强随机 JWT_SECRET ----
AUTH_REQUIRED=true
JWT_SECRET=请替换为至少 32 字节的强随机串（openssl rand -hex 32）

# ---- 对外公开基址（回调/分享/图片外链用，填你的域名）----
PUBLIC_BASE_URL=https://c.tiaowulan.com

# ---- LLM 密钥：留空走 mock；填入真实 key 后agent 真正调用大模型 ----
LLM_API_KEY=

# ---- 对象存储：local=落本地磁盘（挂载 ./data），可改 oss/s3 ----
STORAGE_BACKEND=local

# ---- 微信/支付（不接可留空，留空则对应功能走未配置态）----
WECHAT_APPID=
WECHAT_SECRET=
# 微信支付 v2（H5 扫码 NATIVE）：PAYMENT_PROVIDER 为「缺省渠道」（前端不传 method 时生效）；
# 前端传 method=wechat_native / alipay 时后端按 method 自动选对应渠道，故微信+支付宝可并存。
PAYMENT_PROVIDER=wechat_h5                   # sandbox | wechat_h5 | wechat | alipay
WECHATPAY_V2_MCH_ID=                       # 商户号
WECHATPAY_V2_API_KEY=                      # APIv2 密钥（32 字节）
WECHATPAY_V2_NOTIFY_URL=https://c.tiaowulan.com/api/pay/notify/wechat_h5
# 支付宝（手机网站支付 alipay.trade.wap.pay，后端返回 pay_url 前端跳转）
ALIPAY_APP_ID=                             # 支付宝开放平台应用 APPID
ALIPAY_PRIVATE_KEY=                        # 应用私钥（RSA2，PEM；注意是「应用私钥」非「支付宝公钥」）
ALIPAY_PUBLIC_KEY=                         # 支付宝公钥（RSA2，PEM；用于回调验签，在开放平台「接口加签」处获取）
ALIPAY_NOTIFY_URL=https://c.tiaowulan.com/api/pay/notify/alipay
# PUBLIC_BASE_URL 已配置时，支付宝回跳地址为 {PUBLIC_BASE_URL}/orders/{order_id}

# ---- 短信验证码（手机号登录）：dev 模式不真实发送 ----
SMS_PROVIDER=dev                       # dev | aliyun
SMS_DEV_CODE=123456                    # dev 固定验证码
# aliyun 模式需填（在阿里云控制台申请签名/模板，模板需含 ${code} 变量）：
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_REGION=cn-hangzhou

# ---- 推荐权重（可选，默认 0.4/0.4/0.2）----
# RECOMMEND_WEIGHTS=0.4,0.4,0.2
