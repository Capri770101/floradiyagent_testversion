# ============================================================
# flora-agent-service 配置样例
# 复制为 .env 后按需填写。变量名需与 config.py 字段对应（不区分大小写）。
# 本文件可提交仓库；.env（含真实密钥）已被 .gitignore 忽略，切勿提交。
# ============================================================

# ============ 应用 ============
APP_NAME=flora-agent-service
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*
DEBUG=false

# ============ LLM（OpenAI 兼容接口）============
# 留空 → 使用内置 Mock 引擎（零配置即可跑通全链路）
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ============ 图像生成（provider 可切换：mock | dashscope | api2img | zhipu）============
IMAGE_PROVIDER=mock
# —— 通义万相 / DashScope ——
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
IMAGE_MODEL=wanx-v1
# —— 第三方中转商 api2img（cc-vibe 等 OpenAI 兼容网关）——
API2IMG_BASE_URL=
API2IMG_API_KEY=
API2IMG_MODEL=gpt-image-2
API2IMG_SIZE=1024x1024
API2IMG_QUALITY=medium
API2IMG_OUTPUT_FORMAT=png
# —— 智谱 AI 文生图（CogView，cogview-3-flash 免费）——
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_MODEL=cogview-3-flash
ZHIPU_SIZE=1024x1024

# ============ 存储 ============
DB_PATH=data/agent_service.db

# ============ 智能体参数 ============
MAX_ITERATIONS=8
HISTORY_LIMIT=20
REQUEST_TIMEOUT=60

# ============ 知识库向量检索（RAG）============
# 轻量向量空间模型（TF-IDF + 字符 n-gram），纯 Python 零依赖、可离线。
# 混合策略：关键词命中保底 ∪ 向量语义召回（多词/长句触发），query_knowledge 接口不变。
RAG_ENABLED=true
RAG_TOP_K=8
RAG_KEYWORD_BOOST=0.35
RAG_MIN_SCORE=0.03

# ============================================================
# 真实小程序接入配置（替换这些即可上线）
# —— 以下三组全部填好，智能体即「对接真实小程序」的成品 ——
# ============================================================

# ---- ① 微信登录（小程序后台「开发管理 → 开发设置」获取）----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ---- ② JWT 鉴权 ----
# 自己生成的随机长串（可用 `python -c "import secrets;print(secrets.token_hex(32))"` 生成）。
# 留空则进程内随机（仅本地联调，重启即失效，生产务必自设）。
JWT_SECRET=
# 令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080
# 是否强制鉴权：true=所有 /chat 必须带 Bearer 令牌；false=dev 模式可用 user_id 直连
AUTH_REQUIRED=false

# ---- ③ 数据源（mock | remote）----
# mock=内置示例数据；remote=对接真实后端（填 REMOTE_API_BASE 即可，契约见 INTEGRATION.md）。
DATA_SOURCE=mock
REMOTE_API_BASE=
REMOTE_TIMEOUT=5.0
REMOTE_PLANS_PATH=/plans
REMOTE_PLAN_DETAIL_PATH=/plans/{id}
REMOTE_SHOPS_PATH=/shops
REMOTE_SHOP_DETAIL_PATH=/shops/{id}

# ---- ④ 支付跳转页（小程序内页路径，随真实小程序调整）----
PAY_PAGE_PATH=/pages/order/confirm
