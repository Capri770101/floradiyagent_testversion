# ============================================================
# flora-agent-service 配置样例
# 复制为 .env 后按需填写。变量名需与 config.py 字段对应（不区分大小写）。
# 本文件可提交仓库；.env（含真实密钥）已被 .gitignore 忽略，切勿提交。
# ============================================================

# ============ 应用 ============
APP_NAME=flora-agent-service
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=
# 跨域白名单：留空=禁止跨域（最安全，仅同源 /docs 与同域前端可用）；
# 上线时改为具体前端域名，多个用逗号分隔，如 https://h5.your-domain.com,https://admin.your-domain.com
# 注意：不要用 "*"，它与「带凭证的跨域请求」在浏览器侧互斥，且存在任意源带凭证隐患。
# 仅在确需 cookie/session 凭证时，将上方 CORS_ALLOW_CREDENTIALS 置 true 并配合具体域名。
CORS_ALLOW_CREDENTIALS=false
DEBUG=false

# ============ LLM（OpenAI 兼容接口）============
# 留空 → LLM 降级 mock 模式（agent 返回占位回复）；需真实对话时配置真实密钥
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1500
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ============ 图像生成（provider 可切换：mock | dashscope | api2img | zhipu）============
IMAGE_PROVIDER=mock
# —— 通义万相 / DashScope ——
IMAGE_API_KEY=
IMAGE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text2image/image-synthesis
IMAGE_MODEL=wanx-v1
# —— 第三方中转商 api2img（cc-vibe 等 OpenAI 兼容网关）——
API2IMG_BASE_URL=
API2IMG_API_KEY=
API2IMG_MODEL=gpt-image-2
API2IMG_SIZE=1024x1024
API2IMG_QUALITY=medium
API2IMG_OUTPUT_FORMAT=png
# —— 智谱 AI 文生图（CogView，cogview-3-flash 免费）——
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_MODEL=cogview-3-flash
ZHIPU_SIZE=1024x1024

# ============ 存储 ============
DB_PATH=data/agent_service.db
# 生图产物 / 商家上传文件目录（相对项目根）
GENERATED_DIR=data/generated
UPLOAD_DIR=data/uploads
# 单图上传上限（字节，默认 5MB）
UPLOAD_MAX_BYTES=5242880
# 允许下载图片的第三方主机白名单（逗号分隔；留空=仅同源）。api2img/zhipu base 主机会自动并入。
IMAGE_DOWNLOAD_ALLOWED_HOSTS=

# ============ 短信（验证码）============
# dev=固定验证码（SMS_DEV_CODE）跑通全链路；real=需自行实现发送通道
SMS_PROVIDER=dev
SMS_DEV_CODE=123456
PHONE_CODE_TTL_SECONDS=300

# ============ 智能体参数 ============
MAX_ITERATIONS=8
HISTORY_LIMIT=20
REQUEST_TIMEOUT=60

# ============ 知识库向量检索（RAG）============
# 轻量向量空间模型（TF-IDF + 字符 n-gram），纯 Python 零依赖、可离线。
# 混合策略：关键词命中保底 ∪ 向量语义召回（多词/长句触发），query_knowledge 接口不变。
RAG_ENABLED=true
RAG_TOP_K=8
RAG_KEYWORD_BOOST=0.35
RAG_MIN_SCORE=0.03

# ============================================================
# 真实小程序接入配置（替换这些即可上线）
# —— 以下三组全部填好，智能体即「对接真实小程序」的成品 ——
# ============================================================

# ---- ① 微信登录（小程序后台「开发管理 → 开发设置」获取）----
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ---- ② JWT 鉴权 ----
# 自己生成的随机长串（可用 `python -c "import secrets;print(secrets.token_hex(32))"` 生成）。
# 留空则进程内随机（仅本地联调，重启即失效，生产务必自设）。
JWT_SECRET=
# 令牌有效期（分钟），默认 7 天
JWT_EXPIRE_MINUTES=10080
# 是否强制鉴权：true=所有 /chat 必须带 Bearer 令牌；false=dev 模式可用 user_id 直连
AUTH_REQUIRED=false

# ---- ②.5 支付超时（分钟）：created/pending_payment 订单超过时限自动取消并返还优惠券 ----
ORDER_PAY_TIMEOUT_MINUTES=30

# ---- ③ 数据源（mock | remote）----
# mock=内置示例数据；remote=对接真实后端（填 REMOTE_API_BASE 即可，契约见 INTEGRATION.md）。
DATA_SOURCE=mock
REMOTE_API_BASE=
REMOTE_TIMEOUT=5.0
REMOTE_PLANS_PATH=/plans
REMOTE_PLAN_DETAIL_PATH=/plans/{id}
REMOTE_SHOPS_PATH=/shops
REMOTE_SHOP_DETAIL_PATH=/shops/{id}

# ---- ④ 支付跳转页（小程序内页路径，随真实小程序调整）----
PAY_PAGE_PATH=/pages/order/confirm

# ---- ④.5 接口限流（每 IP/手机号每分钟；False=整体关闭，仅限压测/联调）----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=30
RATE_LIMIT_AUTH_PER_MINUTE=120
RATE_LIMIT_PHONE_PER_MINUTE=3
RATE_LIMIT_PHONE_LOGIN_PER_MINUTE=10

# ---- ⑤ 支付网关（PAYMENT_PROVIDER: sandbox | wechat | alipay）----
# sandbox=演示（无需凭据，下单即标记支付成功，用于端到端验证，绝不真实扣款），开发期默认值。
# 切到 wechat/alipay 前必须填好下方对应凭据，否则 /pay 明确返回 400（避免半成品上线）。
PAYMENT_PROVIDER=sandbox

# —— 微信支付 v3（小程序 JSAPI）——
# 变量名与 config.py 的 wechatpay_* 字段对应（WXPAY_* 是旧名，已不生效）。
# WECHATPAY_MCH_ID          商户号（微信支付商户平台获取）
# WECHATPAY_APPID           小程序 appid（留空则复用上方 WECHAT_APPID）
# WECHATPAY_API_V3_KEY      32 字节 APIv3 密钥（商户平台→APIv3 密钥，回调 AES-GCM 解密用）
# WECHATPAY_SERIAL_NO       商户 API 证书序列号（apiclient_cert.pem 内 / 商户平台查看）
# WECHATPAY_PRIVATE_KEY     商户私钥 PEM：可直接贴内容，或填 apiclient_key.pem 文件路径
# WECHATPAY_PUBLIC_CERT     微信平台证书 PEM（回调验签用，强烈建议配置；缺失仅跳过验签告警）
# WECHATPAY_NOTIFY_URL      支付成功回调地址，如 https://api.your-domain.com/pay/notify/wechat
WECHATPAY_MCH_ID=
WECHATPAY_APPID=
WECHATPAY_API_V3_KEY=
WECHATPAY_SERIAL_NO=
WECHATPAY_PRIVATE_KEY=
WECHATPAY_PUBLIC_CERT=
WECHATPAY_NOTIFY_URL=

# —— 支付宝（手机网站支付）——
# ALIPAY_APP_ID           支付宝应用 APPID
# ALIPAY_PRIVATE_KEY     应用私钥 PEM（内容或文件路径，开放平台「应用公钥」对应私钥）
# ALIPAY_PUBLIC_KEY      支付宝公钥 PEM（开放平台「支付宝公钥」，回调验签用，非应用公钥）
# ALIPAY_NOTIFY_URL      支付成功回调地址，如 https://api.your-domain.com/pay/notify/alipay
# ALIPAY_GATEWAY         网关（默认支付宝生产环境，无需改）
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
