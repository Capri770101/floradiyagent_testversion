# 复制为 .env 后按需填写。密钥不要提交到 git。

# ---- 大模型（OpenAI 兼容，支持 DeepSeek/通义千问等） ----
LLM_BACKEND=auto            # auto | openai | mock（auto：有 key 走真实模型，否则 mock）

# DeepSeek 示例：
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 通义千问兼容端点示例：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 兼容旧变量名（OPENAI_* 与 LLM_* 均被支持，LLM_* 优先）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# ---- AI 生图（按需选择供应商） ----
IMAGE_PROVIDER=mock         # api2img | dashscope | zhipu | mock

# 方式一（推荐免费）：智谱 CogView-3-Flash（开放平台 https://open.bigmodel.cn）
# 完全免费，但共享额度易 429（已内置 15s*次数 退避重试），出图带智谱角标水印
# IMAGE_PROVIDER=zhipu
# IMAGE_ZHIPU_API_KEY=xxxx.xxxx        # 智谱开放平台申请的 API key
# IMAGE_ZHIPU_MODEL=cogview-3-flash
# IMAGE_ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# IMAGE_ZHIPU_MAX_RETRIES=5            # 429 重试次数
# IMAGE_ZHIPU_RETRY_BASE=15            # 基础等待秒数（15s,30s,45s…）

# 方式二：api2img（OpenAI 兼容中转商，约 0.01 元/张，测试省钱）
# 参考 https://github.com/MrVoler/api2img-skill 推荐的中转商（如 cc-vibe.com），
# base_url 形如 https://api.xxx.com/v1，model 视中转商（如 flux-1.1-pro / gpt-image-1）
# IMAGE_OPENAI_BASE_URL=https://api.cc-vibe.com/v1
# IMAGE_OPENAI_API_KEY=sk-…
# IMAGE_OPENAI_MODEL=gpt-image-2   # cc-vibe 实测该账号可用；其他中转商以控制台为准
# IMAGE_SIZE=1024x1024
# IMAGE_RESULT_BASE=http://127.0.0.1:8000   # b64 结果落盘后对外访问地址（部署时改为域名）

# 方式三：DashScope（通义万相）
# IMAGE_API_KEY=sk-…
# IMAGE_MODEL=wanx-v1

# ---- 智能体 ----
MAX_ITERATIONS=8
HISTORY_LIMIT=20
REPOSITORY=mock             # 真实数据库接入时切换