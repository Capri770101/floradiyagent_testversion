# 密钥与环境
.env
.env.local
settings.yaml
settings.local.yaml

# Python 缓存
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# 数据库（运行时生成）
data/
*.db
*.db-wal
*.db-shm

# SSL 证书私钥/公钥（仅保留 .gitkeep 占位，真实证书切勿入库）
misc/certs/*.pem
misc/certs/*.key
misc/certs/*.crt

# IDE
.idea/

# 虚拟环境
venv/
.venv/

# 旧版备份（重构前存档，不纳入版本控制）
_legacy/

# WorkBuddy 运行时记忆/元数据（非源码）
.workbuddy/

# 浏览器自动化测试缓存（非源码）
.playwright-mcp/

# Playwright 快照/录制产物
*.snapshot.yml
profile-*.yml

# 运行时日志
logs/

